#!/usr/bin/env bash
#
# Downloads every plugin listed in zsh_plugins.txt and compiles them into a
# single static ~/.zsh_plugins.zsh.
#
# The zshrc sources that static file directly instead of calling `antidote
# bundle` on every shell startup, which is what keeps interactive startup fast.
# Doing the compile here means the very first shell on a new machine is already
# fast rather than paying a multi-second clone-and-resolve cost.

set -euo pipefail

if ! command -v zsh >/dev/null 2>&1; then
  echo "zsh not found; skipping plugin compilation." >&2
  exit 0
fi

if [[ ! -e "${HOME}/.antidote/antidote.zsh" ]]; then
  echo "antidote not found at ~/.antidote; skipping plugin compilation." >&2
  exit 0
fi

if [[ ! -e "${HOME}/.zsh_plugins.txt" ]]; then
  echo "~/.zsh_plugins.txt not found; run ./install to link it first." >&2
  exit 0
fi

echo "Compiling zsh plugins (this clones each plugin once and may take a while)..."

# -f skips the user's rc files so a broken/partial config can't break the build.
zsh -f -c '
  source ~/.antidote/antidote.zsh
  antidote bundle <~/.zsh_plugins.txt >| ~/.zsh_plugins.zsh
'

echo "Wrote ~/.zsh_plugins.zsh"
